#!/bin/bash
# pre-push depth ladder — fast by default, full on request:
#   git push              → go vet + go build (~seconds)
#   CHECK=1 git push      → + go test (~98s)
#   PUSH_SKIP_TESTS=1     → escape hatch for WIP
[ "${PUSH_SKIP_TESTS:-0}" = "1" ] && exit 0
CHECK="${CHECK:-${1:-}}" bash "$(git rev-parse --show-toplevel)/scripts/check.sh"
